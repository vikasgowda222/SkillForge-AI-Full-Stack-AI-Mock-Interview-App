# ---------------------------------------------------------------------------
# SkillForge AI — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
#
# SECURITY: Database and AI credentials are SERVER-ONLY. Do not prefix them
# with NEXT_PUBLIC_ — that would ship them in the browser bundle.
# ---------------------------------------------------------------------------

# --- Database (Neon serverless Postgres) ---
# Server-only. Format: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# --- Google Gemini (server-only) ---
GEMINI_API_KEY=
# Optional: override the default model (gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# --- Clerk authentication ---
# Publishable key is safe to expose to the client; the secret key is NOT.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk routing overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Site ---
# Public base URL, used for absolute metadata/OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rate limiting (optional; sensible defaults applied if unset) ---
RATE_LIMIT_INTERVIEWS_PER_HOUR=30
RATE_LIMIT_ANSWERS_PER_HOUR=200
